# ==============================================================================
# Variables de entorno del frontend — IOT-Server
# Copiar este archivo como .env y completar los valores reales.
# ==============================================================================

# URL base de la API del backend (debe incluir /api/v1/ con barra final)
VITE_API_BASE_URL=http://localhost:8000/api/v1/

# ==============================================================================
# Verificación RC del backend (Reto Criptográfico / puzzle)
# ==============================================================================
# El frontend se registra en el backend como una "Application" y obtiene los
# tres valores siguientes.  Al arrancar, el frontend construye un puzzle
# AES-256-CBC + HMAC-SHA256 y lo envía a POST /api/v1/applications/auth.
# Solo el backend genuino puede validarlo, garantizando que no hay un servidor
# impostado en el medio.
#
# Cómo obtener estos valores:
#   1. Crear una Application en el backend (panel de administración o API).
#   2. Guardar de forma segura el `api_key` y `server_key` que retorna el
#      endpoint de creación (solo se entregan una vez).
#   3. Copiar el UUID de la Application como VITE_APP_APPLICATION_ID.
#
# Si cualquiera de los tres valores está vacío, la verificación RC se omite
# (comportamiento por defecto en entornos de desarrollo local).
# ==============================================================================

VITE_APP_APPLICATION_ID=
VITE_APP_API_KEY=
VITE_APP_SERVER_KEY=
